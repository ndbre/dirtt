# Copy to ~/.dirtt-sim.env and fill in:   cp sim.env.example ~/.dirtt-sim.env && chmod 600 ~/.dirtt-sim.env
# Where the rover starts (lat,lon,alt,heading). The satellite map centres here.
HOME_LOCATION=33.4555,-88.789,100,0

# Cloudflare Zero Trust team name: the part before .cloudflareaccess.com
ACCESS_TEAM=
# Access application > Overview > Application Audience (AUD) Tag
ACCESS_AUD=
# Emails that can take over control and restart the simulator (comma-separated)
ADMINS=ndb209@msstate.edu
# Tunnel token from Zero Trust > Networks > Tunnels > your tunnel (the long string after --token)
TUNNEL_TOKEN=

# Usually leave these alone
# TUNNEL_PROTOCOL=http2      # http2 (default, TCP) or quic
AUTH=access
PORT=8000
ARDUPILOT=$HOME/ardupilot
